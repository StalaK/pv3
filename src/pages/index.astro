---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import RecentPostContent from '../components/RecentPostContent.astro';
import Tagline from '../components/Tagline.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} />
	</head>
	<body>
		<Header />
		<main>
			<section>
				<Tagline />
			</section>
			<section>
				<RecentPostContent />
			</section>
		</main>
		<Footer />
	</body>
</html>
